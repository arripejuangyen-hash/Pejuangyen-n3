<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>文法 — 「わけ」のいろいろな使い方 | JLPT N3〜N2</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300&display=swap');

  :root {
    --ink: #1a1a1a;
    --ink-light: #3d3d3d;
    --ink-muted: #707070;
    --paper: #faf9f7;
    --paper-warm: #f5f3ef;
    --rule: #d8d4cc;
    --rule-light: #e8e5e0;
    --accent-red: #c0392b;
    --accent-indigo: #2c3e6b;
    --accent-gold: #a08030;
    --accent-teal: #1f5f6b;
    --badge-n3: #6b4a2a;
    --badge-n2: #7a2a6b;
    --shadow: 0 4px 24px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.05);
    --font-jp: 'Noto Serif JP', 'Noto Sans JP', serif;
    --font-body: 'Source Serif 4', 'Noto Serif JP', serif;
    --font-ui: 'Noto Sans JP', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-body);
    background: #edeae4;
    color: var(--ink);
    line-height: 1.75;
    font-size: 15px;
    padding: 32px 16px 64px;
  }

  .book {
    max-width: 1000px;
    margin: 0 auto;
    background: var(--paper);
    box-shadow: var(--shadow), 0 0 0 1px rgba(0,0,0,0.04);
    border-radius: 2px;
  }

  /* ── Header ── */
  .book-header {
    background: var(--ink);
    color: #fff;
    padding: 40px 52px 32px;
    position: relative;
    overflow: hidden;
  }
  .book-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg, transparent, transparent 59px,
      rgba(255,255,255,0.03) 59px, rgba(255,255,255,0.03) 60px
    );
  }
  .book-header::after {
    content: 'わけ';
    position: absolute;
    right: 44px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-jp);
    font-size: 130px;
    font-weight: 700;
    color: rgba(255,255,255,0.04);
    line-height: 1;
    pointer-events: none;
    letter-spacing: -0.04em;
  }
  .book-header-inner { position: relative; }
  .book-series {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.42);
    margin-bottom: 12px;
  }
  .book-title {
    font-family: var(--font-jp);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .book-title .main-kana {
    font-size: 44px;
    letter-spacing: 0.08em;
    color: #f0e6c8;
  }
  .book-title span {
    display: block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    color: rgba(255,255,255,0.52);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }
  .book-meta {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ── Body ── */
  .book-body { padding: 44px 52px 52px; }

  /* ── Chapter Intro ── */
  .chapter-intro {
    border-left: 4px solid var(--accent-red);
    padding: 14px 20px;
    background: var(--paper-warm);
    margin-bottom: 36px;
    font-size: 14px;
    color: var(--ink-light);
    line-height: 1.9;
  }
  .chapter-intro strong { font-weight: 600; color: var(--ink); }

  /* ── TOC ── */
  .toc {
    background: var(--paper-warm);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 20px 24px;
    margin-bottom: 48px;
  }
  .toc-title {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
  }
  .toc-list { list-style: none; display: flex; flex-direction: column; gap: 7px; }
  .toc-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-light);
  }
  .toc-num {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-red);
    white-space: nowrap;
    min-width: 22px;
  }
  .toc-jp {
    font-family: var(--font-jp);
    font-size: 15px;
    color: var(--ink);
    min-width: 200px;
  }
  .toc-desc { color: var(--ink-muted); font-size: 12px; }

  /* ── JLPT Badge ── */
  .jlpt-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 2px;
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fff;
  }
  .jlpt-badge.n3 { background: var(--badge-n3); }
  .jlpt-badge.n2 { background: var(--badge-n2); }

  /* ── Section ── */
  .section { margin-bottom: 60px; }

  .section-header {
    background: #1e1e1e;
    color: #fff;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .section-num {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.38);
    white-space: nowrap;
  }
  .section-jp {
    font-family: var(--font-jp);
    font-size: 20px;
    font-weight: 700;
    color: #f0e6c8;
    letter-spacing: 0.06em;
  }
  .section-id {
    font-family: var(--font-ui);
    font-size: 12px;
    color: rgba(255,255,255,0.5);
  }

  /* ── Subsection ── */
  .subsection {
    border: 1px solid var(--rule);
    border-top: none;
    margin-bottom: 0;
  }
  .subsection-body { padding: 26px 24px; }

  /* ── Grammar Box (Pola) ── */
  .grammar-box {
    background: #1e2a3a;
    border-radius: 3px;
    padding: 15px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .gb-label {
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.38);
    padding-top: 3px;
    white-space: nowrap;
  }
  .gb-pola {
    font-family: var(--font-jp);
    font-size: 15.5px;
    color: #f0e6c8;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }
  .gb-pola .alt {
    color: rgba(240,230,200,0.52);
    font-size: 13px;
  }

  /* ── Desc ── */
  .desc {
    font-size: 13.5px;
    color: var(--ink-light);
    line-height: 1.9;
    margin-bottom: 18px;
  }
  .desc strong { font-weight: 600; color: var(--ink); }

  /* ── Meaning Cards ── */
  .meaning-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 22px;
  }
  .meaning-card {
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }
  .meaning-card-head {
    background: #3a3a3a;
    color: #fff;
    padding: 8px 14px;
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .meaning-card-head .mc-jp {
    font-family: var(--font-jp);
    font-size: 13px;
    color: #f0e6c8;
    margin-left: 8px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .meaning-card-body {
    padding: 12px 14px;
    font-size: 13px;
    color: var(--ink-light);
    line-height: 1.8;
    background: var(--paper);
  }

  /* ── Table ── */
  .grammar-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 22px;
    border: 1px solid var(--rule);
  }
  .grammar-table thead tr { background: #2a2a2a; color: #fff; }
  .grammar-table thead th {
    padding: 10px 13px;
    text-align: left;
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .grammar-table tbody tr:nth-child(even) { background: var(--paper-warm); }
  .grammar-table tbody tr:hover { background: #ece8df; transition: background 0.15s; }
  .grammar-table td {
    padding: 12px 13px;
    border-bottom: 1px solid var(--rule-light);
    vertical-align: top;
    line-height: 1.75;
    color: var(--ink-light);
    font-size: 13px;
  }
  .grammar-table td.pola-cell {
    font-family: var(--font-jp);
    font-size: 13.5px;
    color: var(--accent-indigo);
    line-height: 1.9;
  }
  .grammar-table td.makna { font-weight: 600; color: var(--ink); }

  /* ── Example Box ── */
  .example-box {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent-indigo);
    border-radius: 2px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .example-box-head {
    background: #eceaf5;
    padding: 4px 14px;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-indigo);
    border-bottom: 1px solid #d8d4f0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .example-box-body { padding: 13px 17px; background: var(--paper); }
  .example-jp {
    font-family: var(--font-jp);
    font-size: 17px;
    font-weight: 400;
    line-height: 2.1;
    color: var(--ink);
    margin-bottom: 5px;
  }
  .example-jp .highlight {
    color: var(--accent-red);
    font-weight: 700;
    border-bottom: 1.5px solid var(--accent-red);
    padding-bottom: 1px;
  }
  .example-id {
    font-size: 13px;
    color: var(--ink-muted);
    font-style: italic;
    line-height: 1.6;
  }
  .example-note {
    margin-top: 6px;
    font-size: 11.5px;
    color: var(--accent-indigo);
    font-family: var(--font-ui);
    font-style: normal;
  }

  /* ── Context label on example ── */
  .ctx {
    display: inline-block;
    background: #2a2a2a;
    color: rgba(255,255,255,0.85);
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 1px 7px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  /* ── Note / Warning / Info Boxes ── */
  .note-box {
    background: #fff9ec;
    border: 1px solid #e8d89a;
    border-left: 4px solid var(--accent-gold);
    border-radius: 2px;
    padding: 14px 18px;
    margin-top: 16px;
    font-size: 13px;
    line-height: 1.85;
    color: #4a3800;
  }
  .note-box .note-title {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .note-box .note-title::before { content: '★'; }
  .note-box ul { padding-left: 18px; }
  .note-box li { margin-bottom: 5px; }
  .note-box p { margin-bottom: 6px; }

  .warning-box {
    background: #fff4f4;
    border: 1px solid #e8a0a0;
    border-left: 4px solid var(--accent-red);
    border-radius: 2px;
    padding: 14px 18px;
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.85;
    color: #4a0000;
  }
  .warning-box .note-title {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-red);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .warning-box .note-title::before { content: '✕'; }
  .warning-box ul { padding-left: 18px; }
  .warning-box li { margin-bottom: 5px; }

  .info-box {
    background: #f0f4ff;
    border: 1px solid #aab8e8;
    border-left: 4px solid var(--accent-indigo);
    border-radius: 2px;
    padding: 14px 18px;
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.85;
    color: #1a2240;
  }
  .info-box .note-title {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-indigo);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .info-box .note-title::before { content: '◆'; font-size: 10px; }
  .info-box ul { padding-left: 18px; }
  .info-box li { margin-bottom: 5px; }
  .info-box p { margin-bottom: 6px; }

  /* ── Contrast strip (side-by-side sentences) ── */
  .contrast-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
    margin: 18px 0;
    font-size: 13px;
  }
  .contrast-col { padding: 14px 16px; }
  .contrast-col:first-child {
    background: #f8f0f0;
    border-right: 1px solid var(--rule);
  }
  .contrast-col:last-child { background: #f0f8f0; }
  .contrast-label {
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .contrast-col:first-child .contrast-label { color: #8a2a2a; }
  .contrast-col:last-child  .contrast-label { color: #2a6b2a; }
  .contrast-jp {
    font-family: var(--font-jp);
    font-size: 15px;
    line-height: 2;
    color: var(--ink);
  }
  .contrast-jp .h { color: var(--accent-red); font-weight: 700; }
  .contrast-id { font-size: 12px; color: var(--ink-muted); font-style: italic; margin-top: 4px; }

  /* ── Flow diagram: nuance chain ── */
  .nuance-chain {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 20px 0;
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }
  .nuance-step {
    flex: 1;
    padding: 14px 16px;
    background: var(--paper-warm);
    border-right: 1px solid var(--rule);
    font-size: 12.5px;
    color: var(--ink-light);
    line-height: 1.75;
  }
  .nuance-step:last-child { border-right: none; }
  .nuance-step .ns-label {
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }
  .nuance-step .ns-jp {
    font-family: var(--font-jp);
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .nuance-arrow {
    display: flex;
    align-items: center;
    padding: 0 4px;
    font-size: 18px;
    color: var(--ink-muted);
    background: var(--paper-warm);
    border-right: 1px solid var(--rule);
  }

  /* ── Divider ── */
  .section-divider {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 52px 0;
  }

  /* ── Comparison section ── */
  .comparison-section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }
  .comparison-section h3 {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 16px;
    border-left: 3px solid var(--accent-indigo);
    padding-left: 10px;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    border: 1px solid var(--rule);
    margin-bottom: 18px;
  }
  .compare-table thead tr { background: #3d3d3d; color: #fff; }
  .compare-table thead th {
    padding: 9px 12px;
    text-align: left;
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .compare-table tbody tr:nth-child(even) { background: var(--paper-warm); }
  .compare-table tbody tr:hover { background: #ece8df; }
  .compare-table td {
    padding: 11px 13px;
    border-bottom: 1px solid var(--rule-light);
    vertical-align: top;
    line-height: 1.75;
    color: var(--ink-light);
    font-size: 13px;
  }
  .compare-table td:first-child {
    font-family: var(--font-jp);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-red);
    white-space: nowrap;
  }

  /* ── Tags ── */
  .tag-formal {
    display: inline-block;
    background: #e8eaf4;
    color: var(--accent-indigo);
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 1px 6px;
    border-radius: 2px;
    margin-left: 4px;
    vertical-align: middle;
    text-transform: uppercase;
  }
  .tag-informal {
    display: inline-block;
    background: #f4e8ea;
    color: #8a2a3a;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 1px 6px;
    border-radius: 2px;
    margin-left: 4px;
    vertical-align: middle;
    text-transform: uppercase;
  }
  .tag-neg {
    display: inline-block;
    background: #f4e8f4;
    color: #6b2a6b;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 1px 6px;
    border-radius: 2px;
    margin-left: 4px;
    vertical-align: middle;
    text-transform: uppercase;
  }

  /* ── Ruby ── */
  ruby { ruby-align: center; }
  rt {
    font-size: 0.55em;
    font-family: var(--font-ui);
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  /* ── Footer ── */
  .book-footer {
    border-top: 2px solid var(--ink);
    padding: 22px 52px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    body { padding: 0 0 48px; }
    .book { border-radius: 0; }
    .book-header { padding: 28px 20px 24px; }
    .book-header::after { display: none; }
    .book-body { padding: 22px 18px 36px; }
    .book-footer { padding: 18px 20px; flex-direction: column; gap: 8px; text-align: center; }
    .book-title .main-kana { font-size: 32px; }
    .meaning-cards { grid-template-columns: 1fr; }
    .contrast-strip { grid-template-columns: 1fr; }
    .contrast-col:first-child { border-right: none; border-bottom: 1px solid var(--rule); }
    .nuance-chain { flex-direction: column; }
    .nuance-step { border-right: none; border-bottom: 1px solid var(--rule); }
    .nuance-arrow { display: none; }
    .grammar-table, .compare-table { font-size: 12px; }
    .grammar-table thead th, .compare-table thead th { font-size: 9px; padding: 8px; }
    .grammar-table td, .compare-table td { padding: 9px 8px; }
    .example-jp { font-size: 15px; }
    .toc-jp { min-width: unset; font-size: 13px; }
    .toc-desc { display: none; }
  }

  @media print {
    body { background: #fff; padding: 0; }
    .book { box-shadow: none; }
    .example-box, .note-box, .warning-box, .info-box { break-inside: avoid; }
    .section { break-inside: avoid; }
  }
</style>
</head>
<body>

<article class="book">

  <!-- ══ HEADER ══ -->
  <header class="book-header">
    <div class="book-header-inner">
      <p class="book-series">PejuangYen · Seri Buku Grammar JLPT · Bab 3</p>
